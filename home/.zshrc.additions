# Incremental additions for an existing ~/.zshrc.
# Keep the user's existing shell configuration intact.
# Sources: Mini nix-darwin baseline + personal aliases synced from MacBook (company bits excluded).

_dotfiles_nix_profile="/etc/profiles/per-user/${USER:-chips}"

typeset -U fpath
if [[ -d "$_dotfiles_nix_profile/share/zsh/site-functions" ]]; then
  fpath+=("$_dotfiles_nix_profile/share/zsh/site-functions")
fi
autoload -U compinit && compinit

if [[ -r "$_dotfiles_nix_profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$_dotfiles_nix_profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_AUTOSUGGEST_STRATEGY=(history)
fi

if [[ -r "$_dotfiles_nix_profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$_dotfiles_nix_profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  ZSH_HIGHLIGHT_HIGHLIGHTERS=(main)
fi

if [[ "${TERM:-}" != "dumb" ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if (( $+widgets[autosuggest-accept] )); then
  bindkey '^f' autosuggest-accept
fi

HISTSIZE="${HISTSIZE:-10000}"
SAVEHIST="${SAVEHIST:-10000}"
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

# --- navigation / shell ---
alias .. >/dev/null 2>&1 || alias -- ..='cd ..'
alias c >/dev/null 2>&1 || alias -- c='clear'
alias e >/dev/null 2>&1 || alias -- e='exit'
alias q >/dev/null 2>&1 || alias -- q='exit'
alias ll >/dev/null 2>&1 || alias -- ll='ls -l'
alias mkdir >/dev/null 2>&1 || alias -- mkdir='mkdir -p'
alias pip >/dev/null 2>&1 || alias -- pip='pip3'

# --- git shortcuts (personal; identity stays local via git config) ---
alias add >/dev/null 2>&1 || alias -- add='git add .'
alias push >/dev/null 2>&1 || alias -- push='git push'
alias pull >/dev/null 2>&1 || alias -- pull='git pull'
alias m >/dev/null 2>&1 || alias -- m='git switch main'
alias gc >/dev/null 2>&1 || alias -- gc='git clone'
alias gm >/dev/null 2>&1 || alias -- gm='git commit -a -m'
alias gp >/dev/null 2>&1 || alias -- gp='git push'
alias gb >/dev/null 2>&1 || alias -- gb='git branch'
alias gpl >/dev/null 2>&1 || alias -- gpl='git pull'
alias gf >/dev/null 2>&1 || alias -- gf='git fetch'
alias gs >/dev/null 2>&1 || alias -- gs='git stash'
alias gr >/dev/null 2>&1 || alias -- gr='git rebase'
alias gt >/dev/null 2>&1 || alias -- gt='git log --graph --oneline --all'

# --- fzf helpers ---
alias vf >/dev/null 2>&1 || alias -- vf='nvim $(fzf)'
alias cdt >/dev/null 2>&1 || alias -- cdt='cd $(find * -type d | fzf)'
alias gct >/dev/null 2>&1 || alias -- gct='git checkout $(git branch -r | fzf)'

# --- worktree jumps ---
alias za >/dev/null 2>&1 || alias -- za='cd $(git worktree list | awk '\''NR==2{print $1}'\'')'
alias zb >/dev/null 2>&1 || alias -- zb='cd $(git worktree list | awk '\''NR==3{print $1}'\'')'
alias zc >/dev/null 2>&1 || alias -- zc='cd $(git worktree list | awk '\''NR==4{print $1}'\'')'

# --- agents (high-agency; know what they do) ---
alias cc >/dev/null 2>&1 || alias -- cc='claude --dangerously-skip-permissions'
alias ccp >/dev/null 2>&1 || alias -- ccp='claude --print'
alias co >/dev/null 2>&1 || alias -- co='codex --full-auto'

# Optional fzf defaults (safe if ag/ccat missing; fzf still works)
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:---bind ctrl-e:down,ctrl-u:up --preview \"[[ \\\$(file --mime {}) =~ binary ]] && echo {} is a binary file || (bat --color=always {} 2>/dev/null || cat {}) 2>/dev/null | head -500\"}"
export FZF_COMPLETION_TRIGGER="${FZF_COMPLETION_TRIGGER:-\\}"
export FZF_TMUX_HEIGHT="${FZF_TMUX_HEIGHT:-80%}"

unset _dotfiles_nix_profile
