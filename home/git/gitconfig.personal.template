# git config --global include.path ~/.dotfiles/home/git/gitconfig.personal.template
# Do NOT put company email here.

[user]
	name = chipssss
	email = 694590896@qq.com

[core]
	autocrlf = input
	excludesfile = ~/.dotfiles/home/git/gitignore_global

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

