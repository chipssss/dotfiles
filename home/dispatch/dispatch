class Doctor:
    def __init__(self):
        self.failed = 0

    def say(self, level, area, text):
        self.failed += level == 'FAIL'
        print(f'{level:4}  {area:8} {text}')


def same_file(a, b):
    try:
        return a.read_bytes() == b.read_bytes()
    except OSError:
        return False


def compare_dir(doc, directory):
    """Same-named files in an old scripts directory: identical, a shim, or a local change to merge back."""
    for local in sorted(Path(directory).iterdir()):
        repo = SCRIPTS / local.name
        if not local.is_file():
            continue
        if not repo.is_file():
            doc.say('WARN', 'drift', f'{local} 不在仓库里，待分类的本机 helper（请备份并检查）')
        elif local.is_symlink() and local.resolve() == repo.resolve():
            doc.say('OK', 'drift', f'{local} 是可验证的仓库链接')
        elif same_file(local, repo):
            doc.say('WARN', 'drift', f'{local} 与仓库相同，是旧副本；改成薄 shim 或删除')
        else:
            doc.say('WARN', 'drift', f'{local} 与仓库不同，可能是本机独有改进：diff -u {repo} {local}')


def doctor_repo(doc):
    git = lambda *args: run(['git', '-C', DOTFILES, *args], check=False)
    if git('rev-parse', '--show-toplevel').returncode:
        doc.say('FAIL', 'repo', f'{SCRIPTS} 不在 dotfiles git 仓库里')
        return
    head = git('rev-parse', '--short', 'HEAD').stdout.strip()
    branch = git('branch', '--show-current').stdout.strip() or 'detached'
    fetched = run(['git', '-C', DOTFILES, 'fetch', '-q', 'origin', 'main'], check=False).returncode == 0
    counts = git('rev-list', '--left-right', '--count', 'HEAD...origin/main').stdout.split()
    ahead, behind = (int(c) for c in counts) if len(counts) == 2 else (0, 0)
    upstream = git('rev-parse', '--short', 'origin/main').stdout.strip()
    level = 'WARN' if behind or not fetched else 'OK'
    doc.say(level, 'version', f'本机 {DOTFILES} {branch}@{head}；仓库 origin/main@{upstream}'
            f'{"（fetch 失败，用的是上次的 origin/main）" if not fetched else ""}；领先 {ahead}，落后 {behind}'
            + ('；git pull 后 ./rebuild.sh' if behind else ''))
    if ahead:
        doc.say('WARN', 'version', f'有 {ahead} 个本地提交没进 origin/main：git -C {DOTFILES} log origin/main..HEAD')
    dirty = git('status', '--porcelain', '--', 'home/dispatch', 'home/.claude/rules', 'tests').stdout.splitlines()
    for line in dirty:
        doc.say('WARN', 'version', f'未提交的本机改动 {line[3:]}：通用改进提 PR 合回 dotfiles')


def doctor_install(doc, compare):
    """compare collects old helper directories named by local pi-worker copies."""
    for installed, repo in INSTALLED.items():
        if installed.is_symlink() and installed.resolve() == repo.resolve():
            doc.say('OK', 'install', f'{installed} -> 仓库')
        elif installed.is_symlink():
            doc.say('FAIL', 'install', f'{installed} 链到 {os.readlink(installed)}，不是本仓库；./rebuild.sh')
        elif installed.is_file() and same_file(installed, repo):
            doc.say('WARN', 'install', f'{installed} 是与仓库相同的副本；移走后 ./rebuild.sh 换成链接')
        elif installed.is_file():
            doc.say('WARN', 'drift', f'{installed} 是本机副本且与仓库不同：diff -u {repo} {installed}；'
                    '通用改进合回仓库，项目特定的值移进 dispatch.config，再移走它 ./rebuild.sh')
            m = re.search(r'(?m)^PI_SCRIPTS=(/\S+)$', installed.read_text(errors='replace'))
            if m and Path(m[1]).is_dir():
                compare.add(Path(m[1]).resolve())  # an old pi-worker copy names its helper directory
        else:
            doc.say('FAIL', 'install', f'{installed} 不存在；./rebuild.sh')
    bin_dir = Path.home() / '.claude/bin'
    for extra in sorted(bin_dir.iterdir()) if bin_dir.is_dir() else []:
        if extra in INSTALLED or not extra.is_file():
            continue
        repo = SCRIPTS / extra.name
        if same_file(extra, repo):
            doc.say('WARN', 'drift', f'{extra} 与仓库 {repo.name} 相同，已由仓库提供，可删除')
        elif repo.exists():
            doc.say('WARN', 'drift', f'{extra} 与仓库不同：diff -u {repo} {extra}')
        else:
            doc.say('WARN', 'drift', f'{extra} 不在仓库里（本机独有工具或备份）')
    found = shutil.which('dispatch')
    link = next(iter(INSTALLED))
    if link.exists() and (not found or Path(found).resolve() != SCRIPTS / 'dispatch'):
        doc.say('WARN', 'install', f'PATH 上的 dispatch 是 {found or "无"}；把 {link.parent} 加进 PATH')


def doctor_config(doc):
    p = dispatchconf.path()
    source = 'DISPATCH_CONFIG' if os.environ.get('DISPATCH_CONFIG') else '默认路径'
    try:
        conf = dispatchconf.load()
    except (OSError, ValueError) as e:
        doc.say('FAIL', 'config', f'{p} 无法读取：{e}')
        return {}
    if not conf:
        doc.say('FAIL', 'config', f'{p}（{source}）不存在：从 {SCRIPTS / "dispatch.config.example"} 复制并填写')
        return {}
    try:
        dispatchconf.approval_policy(conf)
    except ValueError:
        doc.say('FAIL', 'config', '自动批准策略不完整，写操作将等待人工')
    if conf.get('merge_script'):
        doc.say('FAIL', 'config', '旧 merge_script 协议已禁用，不能自动合入')
    doc.say('OK', 'config', f'{p}（{source}{"，链到 " + str(p.resolve()) if p.is_symlink() else ""}）')
    for key in sorted(set(conf) - CONFIG_KEYS):
        if not key.startswith('secret_pattern.'):
            doc.say('WARN', 'config', f'未知配置项 {key}（拼错了？）')
    for key in REQUIRED:
        if not conf.get(key):
            doc.say('FAIL', 'config', f'缺少 {key}')
    for key in ('repo', 'state_dir', 'evidence_dir', 'role_brief', 'review_checklist', 'card_log'):
        f = dispatchconf.file(conf, key)
        if f and not f.exists():
            doc.say('FAIL' if key in REQUIRED else 'WARN', 'config', f'{key} = {f} 不存在')
    repo = dispatchconf.file(conf, 'repo')
    if repo and repo.exists():
        if run(['git', '-C', repo, 'remote', 'get-url', 'origin'], check=False).returncode:
            doc.say('FAIL', 'config', f'repo {repo} 不是带 origin 的 git 仓库')
        elif conf.get('merge_script') and run(['git', '-C', repo, 'cat-file', '-e',
                                                f'origin/main:{conf["merge_script"]}'], check=False).returncode:
            doc.say('FAIL', 'config', f'origin/main 上没有 merge_script {conf["merge_script"]}')
    first, _, last = conf.get('ports', '3110-3999').partition('-')
    if not (first.isdigit() and (not last or last.isdigit())):
        doc.say('FAIL', 'config', f'ports = {conf["ports"]} 应写成 起-止')
    if conf.get('card_command') and '{title}' not in conf['card_command']:
        doc.say('WARN', 'config', 'card_command 里没有 {title} 占位符')
    return conf


def doctor_deps(doc, conf):
    needed = ['python3', 'git', 'gh', 'pi', 'rex', 'lsof', 'osascript', 'sandbox-exec', 'realpath']
    optional = {'op': '凭据读取'}
    if conf.get('merge_script', '').endswith(('.mjs', '.js')):
        needed.append('node')
    if conf.get('card_command'):
        needed.append(shlex.split(conf['card_command'])[0])
    try:
        families = {reviewer_for(f)['family'] for f in ('openai', 'anthropic')}
        doc.say('OK', 'models', f'{MODELS} 的「{REVIEW_ROLE}」可跨族评审')
        if 'anthropic' in families:
            needed.append('claude')
    except (Refused, OSError) as e:
        doc.say('FAIL', 'models', str(e))
    for tool in needed:
        path = shutil.which(tool)
        doc.say('OK' if path else 'FAIL', 'deps', f'{tool} {path or "不在 PATH 上"}')
    for tool, why in optional.items():
        doc.say('OK' if shutil.which(tool) else 'WARN', 'deps', f'{tool}（{why}）{shutil.which(tool) or "不在 PATH 上"}')
    if shutil.which('gh') and run(['gh', 'auth', 'status'], check=False).returncode:
        doc.say('FAIL', 'deps', 'gh 没有登录：gh auth login')


def cmd_doctor(a):
    doc = Doctor()
    doctor_repo(doc)
    compare = {Path(d).resolve() for d in a.compare}
    doctor_install(doc, compare)
    for directory in sorted(compare):
        compare_dir(doc, directory)
    conf = doctor_config(doc)
    doctor_deps(doc, conf)
    print(f'\n{"有 " + str(doc.failed) + " 项 FAIL" if doc.failed else "没有 FAIL"}；WARN 是建议处理的漂移或缺口')
    sys.exit(1 if doc.failed else 0)


def main():
    ap = argparse.ArgumentParser(prog='dispatch', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('start')
    s.add_argument('name')
    s.add_argument('brief')
    s.add_argument('--base', default='main')
    s.add_argument('--branch')
    s.add_argument('--existing-branch', action='store_true', help='续写当前 origin 仓库的已有 OPEN PR 分支')
    s.add_argument('--common')
    g = s.add_mutually_exclusive_group()
    g.add_argument('--card')
    g.add_argument('--new-card', metavar='TITLE')
    s.add_argument('--timeout', type=int, default=180)
    s.add_argument('--model')
    s.add_argument('--thinking')
    s.add_argument('--dry-run', action='store_true')
    s = sub.add_parser('status')
    s.add_argument('--json', action='store_true')
    s = sub.add_parser('wait')
    s.add_argument('cursor', nargs='?')
    s = sub.add_parser('review')
    s.add_argument('name', nargs='?')
    s.add_argument('--pr', type=int)
    s.add_argument('--author', help='作者实际 provider/model slug，不是 runner 名')
    s.add_argument('--brief')
    s.add_argument('--worktree')
    s.add_argument('--force', action='store_true')
    s = sub.add_parser('merge')
    s.add_argument('pr', type=int)
    s.add_argument('--dry-run', action='store_true')
    s = sub.add_parser('adopt')
    s.add_argument('name')
    s.add_argument('--out', required=True)
    s.add_argument('--model', help='已有面板的实际模型 slug；省略则不能自动评审')
    s.add_argument('--branch')
    s.add_argument('--timeout', type=int, default=180)
    s.add_argument('--force', action='store_true')
    s = sub.add_parser('clean')
    s.add_argument('name')
    s.add_argument('--force', action='store_true')
    s = sub.add_parser('doctor')
    s.add_argument('--compare', action='append', default=[], metavar='DIR',
                   help='也对比这个旧脚本目录里的同名文件')
    s = sub.add_parser('_run')
    s.add_argument('name')
    a = ap.parse_args()
    if a.cmd == 'wait':
        os.execv('/bin/sh', ['sh', str(SCRIPTS / 'pi-events-wait.sh'), *([a.cursor] if a.cursor else [])])
    if a.cmd == 'review' and not (a.name or a.pr):
        ap.error('review 需要 NAME 或 --pr')
    if a.cmd == 'doctor':
        cmd_doctor(a)
    try:
        configure()
        {'start': cmd_start, 'status': cmd_status, 'review': cmd_review, 'merge': cmd_merge,
         'adopt': cmd_adopt, 'clean': cmd_clean, '_run': cmd_run}[a.cmd](a)
    except Refused as e:
        print(f'dispatch: {e}', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
